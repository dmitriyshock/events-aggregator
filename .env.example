# Copy to .env, fill in local credentials, then use:
# uv run --env-file .env uvicorn events_aggregator.main:app --reload
DATABASE_URL=postgresql+asyncpg://events:local-password@localhost:5432/events
EVENTS_PROVIDER_API_KEY=replace-with-portal-profile-token
EVENTS_PROVIDER_BASE_URL=https://events-provider.dev-2.python-labs.ru
CAPASHINO_API_KEY=replace-with-portal-profile-token
CAPASHINO_BASE_URL=https://capashino.dev-2.python-labs.ru
CAPASHINO_TIMEOUT_SECONDS=10
OUTBOX_INTERVAL_SECONDS=5
OUTBOX_BATCH_SIZE=50
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=86400
SENTRY_DSN=
APP_ENVIRONMENT=development
ENABLE_ERROR_TEST_ENDPOINT=false
